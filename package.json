{
  "name": "samebase-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "node ./scripts/run-dev.ts",
    "dev:frontend": "vp dev",
    "dev:worktree": "node ./scripts/run-worktree-dev.ts",
    "check": "tsc && tsc --project convex/tsconfig.json && tsc --project tsconfig.alchemy.json",
    "build": "pnpm run build:app",
    "build:app": "tsc && vp build",
    "deploy": "node ./scripts/reject-workers-build.ts && convex-hosting deploy --build \"pnpm run build:app\" --dist dist/client --html-handling drop-trailing-slash",
    "preview": "vp preview",
    "prepare": "vp config --no-agent",
    "deploy:dev": "convex-hosting deploy --dev --build \"pnpm run build:app\" --dist dist/client --html-handling drop-trailing-slash"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.94",
    "@samebase/convex-hosting": "0.15.0",
    "@samebase/convex-hosting-tanstack-start": "0.11.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@alchemy.run/github": "2.0.0-beta.84",
    "@effect/platform-node": "4.0.5",
    "@samebase/alchemy-convex": "0.20.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.1.1"
}
